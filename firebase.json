{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "creationcue",
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/classic",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/classic.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/v2",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/v2.html",
        "destination": "/",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/tax",
        "destination": "/tax.html"
      },
      {
        "source": "/month-planner",
        "destination": "/month-planner.html"
      },
      {
        "source": "/manage-coupons",
        "destination": "/manage-coupons.html"
      },
      {
        "source": "/promo-details",
        "destination": "/promo-details.html"
      },
      {
        "source": "/reddit-generator",
        "destination": "/reddit-generator.html"
      },
      {
        "source": "/watch-recorder",
        "destination": "/watch-recorder.html"
      },
      {
        "source": "/play-versions",
        "destination": "/play-versions.html"
      },
      {
        "source": "/play-deploy",
        "destination": "/play-deploy.html"
      },
      {
        "source": "/blog",
        "destination": "/blog.html"
      },
      {
        "source": "/install",
        "destination": "/install.html"
      },
      {
        "source": "/live",
        "destination": "/live.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      ".*",
      ".git/**",
      ".gemini/**",
      "node_modules/**",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "fetch-play-versions.js",
      "play-credentials.json",
      "stats.json",
      "OFF*",
      "scripts/**",
      "**/*.bat",
      "**/*.ps1",
      "**/*.sh",
      "**/*.exe",
      "bin_adb/**",
      "build/**",
      "dist/**",
      "docs/**",
      "blog/images/**",
      "scratch/**",
      "tickets/**",
      "*backup*",
      "*.pdf",
      "dragon*",
      "*.py",
      "*.pkg",
      "*.pyz",
      "lighthouse*.json",
      "all_found_promotions.json",
      "promotions_summary.json"
    ],
    "maxReleases": 2,
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/admin-bar.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.vcf",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/vcard; charset=utf-8"
          },
          {
            "key": "Content-Disposition",
            "value": "inline"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|ico|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "marketing_campaigns.json",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          },
          {
            "key": "Access-Control-Allow-Methods",
            "value": "GET, OPTIONS"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
