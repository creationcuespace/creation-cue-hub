{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "creationcue",
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/tax",
        "destination": "/tax.html"
      },
      {
        "source": "/month-planner",
        "destination": "/month-planner.html"
      },
      {
        "source": "/manage-coupons",
        "destination": "/manage-coupons.html"
      },
      {
        "source": "/reddit-generator",
        "destination": "/reddit-generator.html"
      },
      {
        "source": "/watch-recorder",
        "destination": "/watch-recorder.html"
      },
      {
        "source": "/play-versions",
        "destination": "/play-versions.html"
      },
      {
        "source": "/play-deploy",
        "destination": "/play-deploy.html"
      },
      {
        "source": "/blog",
        "destination": "/blog.html"
      },
      {
        "source": "/live",
        "destination": "/live.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/v2",
        "destination": "/v2.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "fetch-play-versions.js",
      "play-credentials.json",
      "stats.json",
      "OFF*",
      "scripts/**",
      "**/*.bat",
      "**/*.ps1",
      "**/*.sh",
      "docs/**",
      "blog/images/**",
      "scratch/**",
      "*backup*"
    ],
    "maxReleases": 5,
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/admin-bar.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.vcf",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/vcard; charset=utf-8"
          },
          {
            "key": "Content-Disposition",
            "value": "inline"
          }
        ]
      }
    ]
  }
}
