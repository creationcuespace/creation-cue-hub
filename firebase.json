{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "creationcue",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "fetch-play-versions.js",
      "play-credentials.json",
      "stats.json",
      "OFF*",
      "scripts/**",
      "**/*.bat",
      "**/*.ps1",
      "**/*.sh",
      "tracker/**",
      "docs/**",
      "blog/images/**"
    ],
    "maxReleases": 5
  }
}
