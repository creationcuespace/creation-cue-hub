{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "creationcue",
    "public": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "package.json",
      "package-lock.json",
      "fetch-play-versions.js",
      "play-credentials.json",
      "stats.json",
      "OFF*",
      "scripts/**",
      "**/*.bat",
      "**/*.ps1",
      "**/*.sh",
      "tracker/**",
      "docs/**",
      "blog/images/**",
      "scratch/**",
      "*backup*"
    ],
    "maxReleases": 5,
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
